rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Galeri ve personel fotoğrafları: herkes görebilir, yükleme/silme sadece admin.
    match /gallery/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /staff/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Diğer her şey kapalı.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
